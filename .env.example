# ---------------------------------------------------------------
# Voltix Dynamics - environment variables
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------

# SERVER-ONLY secrets (never prefix with NEXT_PUBLIC_ -> never sent to the browser).
# Any HTTPS endpoint that accepts a JSON POST (Slack / Discord / Make / Zapier / n8n ...).
# The payload contains both "text" (Slack-style) and "content" (Discord-style) fields.
SOS_WEBHOOK_URL=
QUOTE_WEBHOOK_URL=

# Server-only Groq credentials. Use the complete key; never use NEXT_PUBLIC_.
# Groq powers chat, image diagnostics, and audio transcription/triage.
GROQ_API_KEY=""
GROQ_MODEL=

# Groq vision and voice analysis models. These use GROQ_API_KEY.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRIAGE_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Browser-to-Supabase public fault-image uploads. Configure a public bucket and an
# anonymous INSERT policy scoped to this bucket's faults/ path (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=fault-images

# Optional Telegram notifications (server-only).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ALERT_CHAT_ID=""
TELEGRAM_THREAD_ID=

# Server-side DeepSeek API key for chat and optional preliminary triage.
FEATURE_DEEPSEEK_PIPELINE=0
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional server-side per-minute limits. Defaults: vision 5, voice 5, SOS 8, chat 20, agent chat 10, quote 10, callback 10.
RATE_LIMIT_VISION_PER_MINUTE=5
RATE_LIMIT_VOICE_PER_MINUTE=5
RATE_LIMIT_SOS_PER_MINUTE=8
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AGENT_CHAT_PER_MINUTE=10
RATE_LIMIT_QUOTE_PER_MINUTE=10
RATE_LIMIT_CALLBACK_PER_MINUTE=10

# Docker host port for the Voltix web app (bound to localhost only).
APP_PORT=3000

# PUBLIC values (safe to expose; they are shown on the website anyway).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=imadnasri15@gmail.com
