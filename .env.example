# ---------------------------------------------------------------
# Voltix Dynamics - environment variables
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------

# SERVER-ONLY secrets (never prefix with NEXT_PUBLIC_ -> never sent to the browser).
# Any HTTPS endpoint that accepts a JSON POST (Slack / Discord / Make / Zapier / n8n ...).
# The payload contains both "text" (Slack-style) and "content" (Discord-style) fields.
SOS_WEBHOOK_URL=
QUOTE_WEBHOOK_URL=

# Server-only Groq credentials. Use the complete key; never use NEXT_PUBLIC_.
# Groq is used by text chat and optional audio transcription.
GROQ_API_KEY=""
GROQ_MODEL=

# Server-only Google AI Studio / Gemini API key for the existing audio fallback.
# Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=""

# Server-only image analysis endpoint. The default is the deployed image inspection service.
# Override this value if the service requires a different route.
IMAGE_ANALYSIS_ENDPOINT=https://voltix-dpe94xwm0x88.edgeone.dev/
AUDIO_ANALYSIS_ENDPOINT=https://voltix-dpe94xwm0x88.edgeone.dev/

# Optional Telegram notifications (server-only).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ALERT_CHAT_ID=""

# Optional server-only preliminary triage. Disabled unless FEATURE_DEEPSEEK_PIPELINE=1.
FEATURE_DEEPSEEK_PIPELINE=0
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional server-side per-minute limits. Defaults: vision 5, voice 5, SOS 8, chat 20, quote 10, callback 10.
RATE_LIMIT_VISION_PER_MINUTE=5
RATE_LIMIT_VOICE_PER_MINUTE=5
RATE_LIMIT_SOS_PER_MINUTE=8
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_QUOTE_PER_MINUTE=10
RATE_LIMIT_CALLBACK_PER_MINUTE=10

# PUBLIC values (safe to expose; they are shown on the website anyway).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=imadnasri15@gmail.com
