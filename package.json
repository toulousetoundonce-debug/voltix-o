{
  "name": "voltix-dynamics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:achievements && next dev",
    "build": "npm run build:achievements && next build",
    "build:achievements": "tailwindcss -c tailwind.achievements.config.cjs -i styles/achievements.css -o public/achievements.css --minify",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "telegram:preview": "node scripts/telegram-preview.mjs",
    "pricing:check": "node scripts/pricing-check.mjs",
    "pricing:calibrate": "node scripts/pricing-calibrate.mjs",
    "smoke": "node ./scripts/smoke.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "0.454.0",
    "next": "^15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "^8.5.31",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^15.5.28"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
